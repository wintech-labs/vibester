PORT=3000

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

ASTRA_CLIENT_ID=
ASTRA_CLIENT_SECRET=
ASTRA_SECURE_CONNECT_BUNDLE=
ASTRA_KEYSPACE=
ASTRA_TOKEN=

# Só necessário para apontar pra um cluster Cassandra local/CI (docker-compose.test.yml)
# em vez do DataStax Astra. Se definido, ASTRA_SECURE_CONNECT_BUNDLE/CLIENT_ID/CLIENT_SECRET
# deixam de ser exigidos (ver src/config/cassandra.ts).
CASSANDRA_CONTACT_POINTS=
CASSANDRA_LOCAL_DATA_CENTER=datacenter1

KAFKA_BROKERS=localhost:9092

REDIS_URL=redis://localhost:6379

RATE_LIMIT_MAX=200
RATE_LIMIT_WRITE_MAX=30
RATE_LIMIT_LIKE_MAX=60

# Lista separada por vírgula (ex.: https://app.vibester.com,https://admin.vibester.com).
# Vazia/ausente = aceita qualquer origem (origin: true), com aviso no log —
# configure antes de expor este serviço publicamente.
CORS_ALLOWED_ORIGINS=

# --- post-validation-service ---
# Nome do Service no cluster. Em local, http://localhost:3008.
POST_VALIDATION_URL=http://post-validation-service:3008
# Orçamento da chamada inteira (ms). Estourou = deixa passar e mede.
POST_VALIDATION_TIMEOUT_MS=1000
# block | warn | off
#   block - conteúdo reprovado vira 422 e o post NÃO é criado.
#   warn  - consulta e mede, nunca barra. Suba assim, olhe
#           post_validation_total{result="invalid"} por alguns dias e só então
#           vire block.
#   off   - nem chama (interruptor de emergência).
POST_VALIDATION_MODE=block

# Ocultar post quando a moderação de imagem pede (on | off). Freio de emergência:
# o rollout é controlado pelo IMAGE_MODERATION_MODE do post-validation-service.
POST_MODERATION_HIDE=on
