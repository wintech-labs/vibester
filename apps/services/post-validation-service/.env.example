# Modo do processo: "api" (veredito síncrono) ou "worker" (revalidação via Kafka).
SERVICE_MODE=api
PORT=3008

# Mesmo segredo usado pelo auth-service para assinar o token.
JWT_SECRET=

# --- Kafka ---
KAFKA_BROKERS=

# --- Redis (cache de veredito; best-effort) ---
REDIS_URL=
VALIDATION_CACHE_TTL_SECONDS=600

# --- Limites de conteúdo ---
# Três limites convivem: o app corta a legenda em 280, este serviço em 500 e o
# createPostSchema do post-service em 2000. Quem publica pelo app nunca chega aos
# 500. Ver "Três limites de legenda" no CLAUDE.md deste serviço.
MAX_CONTENT_LENGTH=500
MAX_BODY_BYTES=65536
MAX_TAGS=30
MAX_LINKS=2

# Palavrão forte reprova o post? Discurso de ódio reprova SEMPRE, independente disto.
PROFANITY_BLOCKS=true

# Domínios extras bloqueados, separados por vírgula. Somam à lista embutida.
BLOCKED_DOMAINS=

# Requisições por minuto por IP.
RATE_LIMIT_MAX=120

# --- Moderação de imagem (só o worker) ---
# off | observe | enforce. observe classifica e mede, sem publicar nada.
IMAGE_MODERATION_MODE=off
# API de moderação da OpenAI (gratuita). Sem chave, a moderação fica desligada.
OPENAI_API_KEY=
# Endereço público do bucket (o mesmo R2_PUBLIC_URL do post-service). Só URL
# que começa por aqui é enviada para classificação.
MEDIA_PUBLIC_URL=
IMAGE_MODERATION_TIMEOUT_MS=15000
IMAGE_MODERATION_CONCURRENCY=3
IMAGE_MODERATION_CACHE_TTL_SECONDS=604800
